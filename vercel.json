{
  "version": 2,
  "buildCommand": "npm run build && cp -r generated dist/generated",
  "builds": [
    {
      "src": "dist/src/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dist/**", "generated/**", "prisma/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/src/server.js"
    }
  ]
}